{
  "manifest_version": 3,
  "name": "Linux Entra Bridge",
  "version": "0.1.0",
  "description": "Enables Microsoft Entra ID SSO on Linux via the microsoft-identity-broker D-Bus service",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "cookies",
    "storage",
    "nativeMessaging",
    "alarms",
    "webNavigation"
  ],
  "host_permissions": [
    "https://login.microsoftonline.com/*",
    "https://login.microsoft.com/*",
    "https://login.live.com/*"
  ],
  "optional_host_permissions": [
    "https://graph.microsoft.com/*",
    "https://*.microsoft.com/*",
    "https://*.microsoftonline.com/*",
    "https://*.office.com/*",
    "https://*.office365.com/*",
    "https://*.sharepoint.com/*",
    "https://*.azure.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Linux Entra Bridge",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html"
  }
}
